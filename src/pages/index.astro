---
import Layout from "../layouts/Layout.astro";
import BackgroundPathsHero from "../components/landing/BackgroundPathsHero.jsx";
import TrustMarquee from "../components/landing/TrustMarquee.astro";
import ServicesBento from "../components/landing/ServicesBento.astro";
import SectionHeading from "../components/landing/SectionHeading.astro";
import ParallaxCases from "../components/landing/ParallaxCases.jsx";
import ProcessTimeline from "../components/landing/ProcessTimeline.astro";
import Testimonial from "../components/landing/Testimonial.astro";
import AboutStrip from "../components/landing/AboutStrip.astro";
import FaqTwoColumn from "../components/landing/FaqTwoColumn.astro";
import CtaContact from "../components/landing/CtaContact.astro";
import { CASES, CTA_HREF, CTA_IS_EXTERNAL } from "../data/site.js";
---

<Layout>
  <main class="w-full">
    <BackgroundPathsHero client:load ctaHref={CTA_HREF} ctaExternal={CTA_IS_EXTERNAL} />

    <TrustMarquee />

    <ServicesBento />

    <section id="proyectos" class="relative w-full scroll-mt-24 px-4 py-20">
      <div class="mx-auto max-w-6xl">
        <SectionHeading
          eyebrow="Proyectos destacados"
          title="Resultados reales para clientes reales"
          subtitle="Una muestra de lo que he construido, desde páginas de venta hasta plataformas con IA."
        />
        <ParallaxCases client:visible cases={CASES} />
        <div class="mt-20 text-center">
          <a
            href={CTA_HREF}
            {...(CTA_IS_EXTERNAL ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="inline-flex items-center gap-2 rounded-2xl bg-[#2f6fe3] px-7 py-4 font-semibold text-white shadow-[0_0_40px_rgba(47,111,227,0.4)] transition-all hover:-translate-y-0.5 hover:bg-[#3d7cf0]"
          >
            Quiero un sitio así <span aria-hidden="true">→</span>
          </a>
          <p class="mt-4 text-sm text-white/40">
            Más proyectos en <a href="https://github.com/Jhonjandrysdev" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white">GitHub</a>
          </p>
        </div>
      </div>
    </section>

    <ProcessTimeline />

    <Testimonial />

    <AboutStrip />

    <FaqTwoColumn />

    <CtaContact />
  </main>
</Layout>
