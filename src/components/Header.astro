---
import { CTA_HREF, CTA_IS_EXTERNAL } from "../data/site.js";

const navItems = [
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#proceso", label: "Proceso" },
  { href: "#faq", label: "Preguntas" },
];
---

<header class="fixed top-4 left-0 right-0 z-50 flex justify-center px-4">
  <nav class="flex w-full max-w-3xl items-center justify-between gap-2 rounded-2xl border border-white/10 bg-black/60 px-3 py-2 shadow-[0_8px_32px_rgba(0,0,0,0.4)] backdrop-blur-xl" aria-label="Principal">
    <a href="#top" class="px-2 text-sm font-bold tracking-tight text-white">
      jhonjandrys<span class="text-[#2f6fe3]">.dev</span>
    </a>
    <div class="hidden items-center gap-1 md:flex">
      {navItems.map(({ href, label }) => (
        <a href={href} class="rounded-xl px-3 py-2 text-sm font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white">
          {label}
        </a>
      ))}
    </div>
    <a
      href={CTA_HREF}
      {...(CTA_IS_EXTERNAL ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      class="rounded-xl bg-[#2f6fe3] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#3d7cf0]"
    >
      Cotizar
    </a>
  </nav>
</header>
