---
// Preguntas frecuentes en dos columnas (estilo Two-Column FAQ de 21st.dev). Usa <details>, sin JavaScript.
import { FAQ, CTA_HREF, CTA_IS_EXTERNAL } from "../../data/site.js";
---

<section id="faq" class="relative w-full scroll-mt-24 px-4 py-20">
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[1fr_1.4fr]">
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#5b8ff0]">Preguntas frecuentes</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Resolvamos tus dudas</h2>
      <p class="mt-4 text-white/55">¿No ves tu pregunta? Escríbeme y te respondo el mismo día.</p>
      <a
        href={CTA_HREF}
        {...(CTA_IS_EXTERNAL ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#8ab4ff] hover:text-white"
      >
        Hacer una pregunta <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="reveal divide-y divide-white/10 rounded-3xl border border-white/10 bg-white/[0.02]">
      {FAQ.map((item) => (
        <details class="faq group px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-white">
            {item.q}
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-white/70 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-white/60">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker { display: none; }
</style>
