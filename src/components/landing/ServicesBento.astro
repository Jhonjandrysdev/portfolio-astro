---
// Servicios en bento grid (estilo Agency Bento Grid de 21st.dev).
import SectionHeading from "./SectionHeading.astro";
import { SERVICES, CTA_HREF, CTA_IS_EXTERNAL } from "../../data/site.js";

const icons = [
  // rayo (conversión)
  '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  // tienda / negocio
  '<path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/>',
  // editar
  '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  // chispa IA
  '<path d="M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"/><path d="M19 17l.7 2.1L22 20l-2.3.9L19 23l-.7-2.1L16 20l2.3-.9z"/>',
];
---

<section id="servicios" class="relative w-full scroll-mt-24 px-4 py-20">
  <div class="mx-auto max-w-5xl">
    <SectionHeading eyebrow="Servicios" title="Lo que puedo construir para ti" subtitle="Desde una página de ventas hasta una aplicación con inteligencia artificial." />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {SERVICES.map((s, i) => (
        <article
          class:list={[
            "reveal spotlight group relative overflow-hidden rounded-3xl border p-7 transition-all duration-300 hover:-translate-y-1",
            s.highlight
              ? "md:col-span-2 md:row-span-1 border-[#2f6fe3]/40 bg-gradient-to-br from-[#2f6fe3]/20 via-[#2f6fe3]/5 to-transparent"
              : "border-white/10 bg-white/[0.03] hover:border-white/20",
            s.wide ? "md:col-span-2" : "",
          ]}
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#2f6fe3]/30 bg-[#2f6fe3]/15 text-[#7aa6ff]">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i % icons.length]} />
          </div>
          <h3 class="mt-5 text-xl font-bold text-white sm:text-2xl">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60 sm:text-base">{s.description}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {s.bullets.map((b) => (
              <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/70">{b}</li>
            ))}
          </ul>
          {s.highlight && (
            <a
              href={CTA_HREF}
              {...(CTA_IS_EXTERNAL ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#8ab4ff] hover:text-white"
            >
              Quiero mi landing page <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
