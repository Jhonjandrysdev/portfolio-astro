---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FloatingCta from "../components/landing/FloatingCta.astro";
import "@fontsource-variable/onest";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Desarrollador web en Colombia. Diseño y construyo landing pages, sitios web para negocios, WordPress y aplicaciones con IA que convierten visitas en clientes." />
    <meta name="keywords" content="desarrollador web Colombia, diseño de páginas web, landing pages, sitios web para negocios, WordPress, Elementor, Astro, React, Jhonjandrys Ramirez" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06060f" />
    <link rel="icon" type="image/svg+xml" href="/icon1.svg" />
    <link rel="canonical" href="https://jhonjandrysdev.netlify.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content="Jhonjandrys Ramirez | Sitios web que convierten visitas en clientes" />
    <meta property="og:description" content="Landing pages, sitios para negocios, WordPress y aplicaciones con IA. Cotiza tu proyecto." />
    <meta property="og:url" content="https://jhonjandrysdev.netlify.app/" />
    <meta property="og:image" content="https://jhonjandrysdev.netlify.app/esfuerzo-inteligente.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <title>Jhonjandrys Ramirez | Desarrollador web: sitios que convierten visitas en clientes</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Jhonjandrys Ramirez · Desarrollo web",
      url: "https://jhonjandrysdev.netlify.app/",
      image: "https://jhonjandrysdev.netlify.app/perfil.jpg",
      areaServed: "CO",
      sameAs: ["https://www.linkedin.com/in/jhonjandrysdev/", "https://github.com/Jhonjandrysdev"],
    })} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <FloatingCta />
    <script>
      // Aparición suave de secciones al hacer scroll
      const els = document.querySelectorAll(".reveal");
      if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -10% 0px" });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-blue: #2f6fe3;
    --color-blue-dark: #1a4db5;
    --color-bg: #06060f;
    --color-card: rgba(255, 255, 255, 0.04);
    --color-border: rgba(255, 255, 255, 0.08);
    --color-text-muted: #94a3b8;
  }

  html {
    width: 100%;
    scroll-behavior: smooth;
    background-color: var(--color-bg);
  }

  body {
    width: 100%;
    margin: 0;
    font-family: "Onest Variable", sans-serif;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(47, 111, 227, 0.15) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 80% 100%, rgba(47, 111, 227, 0.08) 0%, transparent 60%),
      var(--color-bg);
    min-height: 100vh;
    color: white;
    overflow-x: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  ::selection {
    background: rgba(47, 111, 227, 0.4);
    color: white;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--color-blue-dark);
    border-radius: 3px;
  }
</style>
